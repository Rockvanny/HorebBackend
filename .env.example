PORT=3000

# --- Entorno de ejecución ---
# El código solo lee NODE_ENV (libs/logger.js, libs/sequelize.js,
# middlewares/error.handler.js): controla si se loguean las queries SQL, si
# el logger de fichero queda silencioso, y si el stack trace de errores viaja
# en la respuesta HTTP. En local usa 'development'; en el contenedor de
# cliente, docker-compose.yml ya fuerza 'production' como variable de entorno
# real (tiene prioridad sobre este fichero, dotenv no la sobrescribe).
NODE_ENV=development

# --- Base de datos ---
DB_USER='CHANGE_ME'
DB_PASSWORD='CHANGE_ME_STRONG_PASSWORD'
DB_HOST='localhost'
DB_NAME='CHANGE_ME'
DB_PORT='5432'

# --- pgAdmin (solo si usas docker-compose) ---
PGADMIN_EMAIL='admin@example.com'
PGADMIN_PASSWORD='CHANGE_ME_STRONG_PASSWORD'

# --- Autenticación / secretos ---
# No hay usuario/contraseña maestro: el primer administrador se crea desde
# el propio frontend (POST /api/v1/setup/first-admin) la primera vez que
# arranca una instalación sin usuarios.
JWT_SECRET='CHANGE_ME_LONG_RANDOM_SECRET'
AES_SECRET='CHANGE_ME_LONG_RANDOM_SECRET'

# --- OTP de login (2FA por email) ---
# Proveedor recomendado: Resend (https://resend.com), API HTTP, sin SMTP.
RESEND_API_KEY='re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
MAIL_FROM='Hexivo Control <no-reply@tudominio.com>'
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_RESENDS=3

# --- Licencia / suscripción ---
# La clave pública de verificación va en config/license-public-key.pem (se
# versiona, es pública). Aquí solo se configura la duración del trial.
TRIAL_DURATION_DAYS=15

# --- Copias de seguridad (servicio `backup` de docker-compose.yml) ---
# Carpeta del HOST donde se guardan los dumps, fuera de Docker. En cliente,
# mejor una ruta absoluta fuera de la carpeta del proyecto y sincronizada con
# otro disco/NAS/nube (ej. Windows: C:/HorebBackups, Linux: /srv/horeb-backups).
BACKUP_DIR=./backups
# Horas de copia (Europe/Madrid). El PC no está siempre encendido: si a esa
# hora estaba apagado, la copia se hace en cuanto se encienda. "00:00" equivale
# a "la primera vez que se enciende cada día" (la copia de la mañana).
BACKUP_TIMES="00:00 16:00"
# Cuántas se conservan: días con copia (daily), semanas y meses.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# Restaurar (sustituye la BD; antes guarda el estado actual en pre-restore/):
#   docker compose stop backend
#   docker compose exec backup bash /usr/local/bin/pg-restore.sh [daily/fichero.dump]
#   docker compose start backend

# --- Instalación BD, PGADMIN y BACKEND en Docker ---
# Ubícate en la carpeta raíz del proyecto y ejecuta:
#   docker compose up --build -d
# Cuando cambies el backend, para reconstruir solo esa imagen:
#   docker compose up -d --build backend*
***
